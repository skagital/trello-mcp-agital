{
  "manifest_version": "0.3",
  "name": "trello-agital",
  "display_name": "Trello agital.online",
  "version": "1.3.0",
  "description": "Trello MCP Server fuer agital.online mit shortLink/URL Support",
  "author": {
    "name": "agital.online GmbH"
  },
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/index.js"],
      "env": {
        "TRELLO_API_KEY": "${user_config.trello_api_key}",
        "TRELLO_TOKEN": "${user_config.trello_token}"
      }
    }
  },
  "user_config": {
    "trello_api_key": {
      "type": "string",
      "title": "Trello API Key",
      "description": "API Key von https://trello.com/power-ups/admin",
      "required": true,
      "sensitive": true
    },
    "trello_token": {
      "type": "string",
      "title": "Trello Token",
      "description": "Token generieren auf der API Key Seite (read/write, never expires)",
      "required": true,
      "sensitive": true
    }
  },
  "tools": [
    {"name": "get_card", "description": "Karte per ID, shortLink oder URL abrufen"},
    {"name": "create_card", "description": "Neue Karte erstellen"},
    {"name": "update_card", "description": "Karte bearbeiten"},
    {"name": "move_card", "description": "Karte verschieben"},
    {"name": "trello_search", "description": "Suche ueber Boards und Karten"},
    {"name": "trello_get_list_cards", "description": "Karten einer Liste abrufen"},
    {"name": "trello_add_comment", "description": "Kommentar hinzufuegen"},
    {"name": "trello_create_checklist", "description": "Checklist auf Karte anlegen"},
    {"name": "trello_add_checklist_item", "description": "Item zu Checklist hinzufuegen"},
    {"name": "trello_update_checklist_item", "description": "Checklist-Item bearbeiten oder abhaken"},
    {"name": "trello_delete_checklist_item", "description": "Checklist-Item loeschen"},
    {"name": "trello_delete_checklist", "description": "Ganze Checklist loeschen"},
    {"name": "trello_add_attachment_url", "description": "URL als Anhang hinzufuegen"},
    {"name": "trello_add_attachment_file", "description": "Datei an Karte hochladen"},
    {"name": "trello_delete_attachment", "description": "Anhang entfernen"}
  ]
}
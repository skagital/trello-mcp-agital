{
  "manifest_version": "0.2",
  "name": "trello-agital",
  "display_name": "Trello agital.online",
  "version": "1.0.0",
  "description": "Trello MCP Server fuer agital.online mit shortLink/URL Support",
  "author": {
    "name": "agital.online GmbH"
  },
  "server": {
    "type": "node",
    "entry_point": "dist/index.js"
  },
  "user_config": {
    "trello_api_key": {
      "type": "string",
      "label": "Trello API Key",
      "description": "API Key von https://trello.com/power-ups/admin",
      "required": true,
      "sensitive": true
    },
    "trello_token": {
      "type": "string",
      "label": "Trello Token",
      "description": "Token generieren auf der API Key Seite (read/write, never expires)",
      "required": true,
      "sensitive": true
    }
  },
  "tools": [
    {"name": "get_card", "description": "Karte per ID, shortLink oder URL abrufen"},
    {"name": "create_card", "description": "Neue Karte erstellen"},
    {"name": "update_card", "description": "Karte bearbeiten"},
    {"name": "move_card", "description": "Karte verschieben"},
    {"name": "trello_search", "description": "Suche ueber Boards und Karten"},
    {"name": "trello_get_list_cards", "description": "Karten einer Liste abrufen"},
    {"name": "trello_add_comment", "description": "Kommentar hinzufuegen"}
  ]
}
